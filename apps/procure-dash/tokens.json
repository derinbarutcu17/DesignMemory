{
  "color": {
    "primary": { "$value": "#1d4ed8", "$type": "color", "$description": "Primary action and accent color" },
    "primaryHover": { "$value": "#1e40af", "$type": "color" },
    "success": { "$value": "#15803d", "$type": "color", "$description": "Healthy supplier and contract states" },
    "warning": { "$value": "#b45309", "$type": "color", "$description": "Watch states and approaching deadlines" },
    "danger": { "$value": "#b91c1c", "$type": "color", "$description": "Critical risk and expired states" },
    "info": { "$value": "#0e7490", "$type": "color" },
    "surface": { "$value": "#ffffff", "$type": "color" },
    "surfaceRaised": { "$value": "#f8fafc", "$type": "color" },
    "border": { "$value": "#e2e8f0", "$type": "color" },
    "borderStrong": { "$value": "#cbd5e1", "$type": "color" },
    "text": { "$value": "#0f172a", "$type": "color" },
    "textMuted": { "$value": "#64748b", "$type": "color" },
    "chartGrid": { "$value": "#eef2f6", "$type": "color" }
  },
  "spacing": {
    "1": { "$value": "4px", "$type": "spacing" },
    "2": { "$value": "8px", "$type": "spacing" },
    "3": { "$value": "12px", "$type": "spacing" },
    "4": { "$value": "16px", "$type": "spacing" },
    "5": { "$value": "20px", "$type": "spacing" },
    "6": { "$value": "24px", "$type": "spacing" },
    "8": { "$value": "32px", "$type": "spacing" }
  },
  "borderRadius": {
    "sm": { "$value": "6px", "$type": "borderRadius" },
    "md": { "$value": "10px", "$type": "borderRadius" },
    "lg": { "$value": "14px", "$type": "borderRadius" },
    "full": { "$value": "9999px", "$type": "borderRadius" }
  },
  "fontSize": {
    "xs": { "$value": "12px", "$type": "fontSize" },
    "sm": { "$value": "14px", "$type": "fontSize" },
    "base": { "$value": "15px", "$type": "fontSize" },
    "lg": { "$value": "18px", "$type": "fontSize" },
    "xl": { "$value": "22px", "$type": "fontSize" },
    "2xl": { "$value": "28px", "$type": "fontSize" }
  },
  "fontFamily": {
    "sans": { "$value": "Inter, system-ui, -apple-system, Segoe UI, sans-serif", "$type": "fontFamily" },
    "mono": { "$value": "ui-monospace, SFMono-Regular, Menlo, monospace", "$type": "fontFamily" }
  },
  "shadow": {
    "card": { "$value": "0 1px 2px rgba(15, 23, 42, 0.06)", "$type": "shadow" },
    "raised": { "$value": "0 4px 12px rgba(15, 23, 42, 0.08)", "$type": "shadow" },
    "overlay": { "$value": "0 18px 40px rgba(15, 23, 42, 0.18)", "$type": "shadow" }
  },
  "typography": {
    "body": {
      "$value": { "fontFamily": "Inter", "fontWeight": "400", "fontSize": "14px", "lineHeight": "20px" },
      "$type": "typography"
    }
  }
}

{
  "name": "@derinb/design-memory",
  "version": "0.3.0",
  "description": "Blocks net-new design drift in AI-written React/Tailwind code. Deterministic, local-first, DTCG-native.",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/derinbarutcu17/DesignMemory.git"
  },
  "scripts": {
    "lint": "eslint .",
    "cli": "tsx src/cli/index.ts",
    "build": "tsc",
    "test": "test -d test && node --import tsx --test \"test/**/*.test.ts\" || echo \"No test files found\"",
    "demo:design-memory:audit": "bash examples/design-memory-showcase/scripts/demo.sh",
    "prepack": "npm run build"
  },
  "dependencies": {
    "zod": "^4.3.6",
    "commander": "^12.0.0",
    "typescript": "^5"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@types/node": "^20",
    "eslint": "^9",
    "tsx": "^4.21.0"
  },
  "license": "MIT",
  "bin": {
    "design-memory": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "agent-plugin.json",
    "mcp.json"
  ]
}

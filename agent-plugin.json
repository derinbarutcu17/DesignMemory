{
  "name": "design-memory",
  "command": "npx -y @derinb/design-memory mcp",
  "localCommand": "node dist/cli/index.js mcp",
  "description": "Design Memory MCP server: design tokens, component contracts, decision memory, and net-new drift audits for coding agents.",
  "tools": [
    "dm_get_context",
    "dm_audit_diff",
    "dm_suggest_token",
    "dm_record_decision",
    "dm_get_decisions",
    "dm_get_tokens",
    "dm_get_contract"
  ],
  "resources": [
    "dm://tokens",
    "dm://design-md",
    "dm://rules",
    "dm://contracts",
    "dm://decisions",
    "dm://config"
  ],
  "prompts": ["dm/implement-component", "dm/fix-drift", "dm/review-drift"]
}
